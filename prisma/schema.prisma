// Prisma schema defining the lightweight SQLite persistence layer that replaces the
// Base44 backend integration. The schema keeps the data model intentionally generic
// so that the React front-end can store arbitrary entity payloads without being
// tightly coupled to a rigid relational structure.

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model EntityRecord {
  id        Int      @id @default(autoincrement())
  type      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type], map: "idx_entity_type")
}

model Conversation {
  id        Int        @id @default(autoincrement())
  agentName String
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]

  @@index([agentName], map: "idx_conversation_agent")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int
  role           String
  content        String
  createdAt      DateTime     @default(now())
}
